{
  "name": "@algogrind/editor-icons",
  "type": "module",
  "version": "0.1.1",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "nx vite:test --run",
    "test:unit:coverage": "nx vite:test --run --coverage",
    "test:e2e": "playwright test",
    "test": "yarn test:unit && yarn test:e2e"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@types/node": "^22.2.0",
    "change-case": "4.1.2",
    "fs-extra": "^11.2.0",
    "got": "^14.4.2",
    "lit": "^3.2.0",
    "svgo": "^3.3.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.2"
  },
  "peerDependencies": {
    "lit": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "module": "./dist/index.js",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__",
    "!dist/__tests__"
  ]
